{
  "name": "nbf-server",
  "version": "1.0.0",
  "description": "Backend API for Nepal Bipolar Foundation (Feathers 5 + Express + MongoDB + TypeScript)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@feathersjs/authentication": "^5.0.0",
    "@feathersjs/authentication-local": "^5.0.0",
    "@feathersjs/configuration": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "feathers-mongoose": "^8.0.0",
    "mongoose": "^8.0.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
