{
  "port": 3030,
  "mongodb": "mongodb://mongo:27017/nepal-bipolar-foundation",
  "authentication": {
    "entity": "user",
    "service": "users",
    "secret": "CHANGE-ME-to-a-long-random-string",
    "entityId": "_id",
    "authStrategies": ["jwt", "local"],
    "jwtOptions": {
      "header": { "typ": "access" },
      "audience": "https://nepalbipolarfoundation.org",
      "issuer": "feathers",
      "algorithm": "HS256",
      "expiresIn": "1d"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password"
    }
  }
}
